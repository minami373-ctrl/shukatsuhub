# 秘密情報
.env
.env.*
!.env.example
*.pem
*.key
# Google OAuth クライアント（Console からダウンロードした JSON。絶対にコミットしない）
client_secret*.json
credentials.json
token.json

# 個人設定（Claude Code の個人用設定。チーム共通は .claude/settings.json）
.claude/settings.local.json

# 依存関係・ビルド成果物
node_modules/
dist/
build/
.next/

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# SQLite（seed から作り直せるのでコミットしない）
# app.db には OAuth トークンと実メールのヘッダが入る。絶対にコミットしない
*.db
backend/app.db
# WAL モードの副産物（db.py で journal_mode=WAL にしたため生成される）。
# 中身は DB そのものなので app.db と同じ扱いにする
backend/app.db-*
*.db-wal
*.db-shm

# OS・エディタ
.DS_Store
Thumbs.db
*.swp

# 実データ・動作確認用データ（実メール等は絶対にコミットしない）
*.mbox
*.eml
data/real/

# TypeScript のビルド情報（ビルドごとに変わるのでコミットしない）
*.tsbuildinfo

# 発表の録画（GitHub の 100MB 制限に触れる。共有は別手段で行う）
slides/*.mp4
slides/*.mov

# スライドの出力物（slides/final.md から作り直せる）
slides/final.pdf

# 個人GitHub公開用リポでは除外するもの
# （社内発表資料一式・実サイト分析文書。ローカルには残す）
/slides/
docs/compliance-ai-web-collection.md
